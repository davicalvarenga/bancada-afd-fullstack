{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend": {
      "root": "backend/",
      "framework": "nestjs",
      "entrypoint": "src/main.ts"
    },
    "frontend": {
      "root": "frontend/",
      "framework": "angular",
      "buildCommand": "npm run build",
      "outputDirectory": "dist/bancada-afd/browser"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "backend" }
    },
    {
      "source": "/([^.]*)",
      "destination": { "service": "frontend", "path": "/index.html" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "frontend" }
    }
  ]
}
